---
import { Maximize, Minus, Plus, RotateCw, ScanSearch } from 'lucide-react'
import DoomBadgeLinks from './doom-badge-links.astro'
import DoomVideo from './doom-video.astro'
---

<section id="doom-simulator" tabindex="-1" aria-label="Doom simulator">
  <header class="doom-toolbar flex flex-wrap items-center justify-between gap-4 pb-4">
    <div>
      <span data-doom-load-state class="sr-only">Auto loading</span>
      <p data-doom-status role="status" class="mt-1 font-mono text-xs text-muted-foreground">Loading Doom runtime</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button data-model-screen class="doom-tool" aria-pressed="false" disabled><ScanSearch /> Screen</button>
      <button data-model-full class="doom-tool" aria-pressed="true" disabled><Maximize /> Full</button>
      <button data-model-rotate class="doom-tool" aria-pressed="false"><RotateCw /> Rotate</button>
      <button data-model-zoom-in class="doom-icon" aria-label="Zoom in" disabled><Plus /></button>
      <button data-model-zoom-out class="doom-icon" aria-label="Zoom out" disabled><Minus /></button>
    </div>
  </header>
  <video data-party-marty-video hidden preload="none" muted loop playsinline></video>

  <div class="doom-stage">
    <div data-doom-model data-state="idle" class="doom-model">
      <canvas data-doom-runtime-screen width="320" height="200" aria-hidden="true"></canvas>
      <div data-doom-fallback class="doom-fallback">
        <canvas data-doom-screen width="320" height="200" tabindex="0" aria-label="Doom display. Use arrow keys, Ctrl or J to fire, Space or K to use, Shift or Alt to strafe, Escape for menu, and Enter to confirm."></canvas>
        <DoomVideo />
      </div>
      <p data-model-status class="pointer-events-none absolute inset-x-4 bottom-3 text-center font-mono text-xs text-muted-foreground">Loading 3D badge view</p>
    </div>

    <div class="doom-inputs mt-4">
      <details class="doom-controls mx-auto max-w-3xl font-mono text-xs text-muted-foreground">
        <summary class="cursor-pointer py-2 text-center uppercase tracking-[0.12em] hover:text-foreground">Controls</summary>
        <p class="mt-2 text-center text-[0.7rem] leading-relaxed">
          Keyboard: arrows move · Ctrl/J fire · Space/K use · Shift/Alt strafe · Escape menu · Enter confirm. Drag outside controls to rotate the badge. Scroll or +/− to zoom.
        </p>
      </details>
      <DoomBadgeLinks />
    </div>
  </div>
</section>

<style>
  .doom-model { position: relative; height: clamp(360px, 68vh, 850px); overflow: hidden; background: #010409; }
  .doom-model :global(> canvas) { display: block; width: 100%; height: 100%; touch-action: none; outline: none; }
  .doom-model :global(> canvas:focus-visible) { outline: 2px solid hsl(var(--primary)); outline-offset: -2px; }
  .doom-model :global(> canvas[data-doom-runtime-screen]) { position: absolute; left: 0; top: 0; width: 320px; height: 200px; opacity: 0; pointer-events: none; }
  .doom-fallback { display: grid; height: 100%; place-items: center; padding: 1rem; }
  .doom-fallback[hidden] { position: absolute; left: 0; top: 0; display: block; width: 320px; height: 200px; padding: 0; opacity: 0; pointer-events: none; overflow: hidden; }
  .doom-fallback[hidden] canvas { width: 320px; height: 200px; border: 0; }
  .doom-fallback canvas { width: min(100%, 960px); aspect-ratio: 8 / 5; image-rendering: pixelated; border: 1px solid hsl(var(--border) / 0.4); background: #010409; }
  .doom-tool, .doom-icon { display: inline-flex; align-items: center; justify-content: center; gap: 0.625rem; border: 1px solid hsl(var(--border) / 0.4); border-radius: 0.375rem; background: transparent; font-family: ui-monospace, monospace; transition: border-color 150ms, background-color 150ms; }
  .doom-tool:hover:not(:disabled), .doom-icon:hover:not(:disabled) { border-color: hsl(var(--primary) / 0.5); background: hsl(var(--primary) / 0.05); }
  .doom-tool { height: 2.25rem; padding: 0 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.75rem; }
  .doom-tool :global(svg), .doom-icon :global(svg) { width: 1rem; height: 1rem; }
  .doom-icon { width: 2.25rem; height: 2.25rem; }
  .doom-tool:disabled, .doom-icon:disabled { opacity: 0.45; }

  @media (min-width: 1024px) {
    #doom-simulator { display: flex; flex-direction: column; min-height: 0; }
    .doom-toolbar { flex-shrink: 0; padding: 1rem; }
    .doom-stage { display: flex; flex: 1; flex-direction: column; min-height: 0; }
    .doom-model { flex: 1; min-height: 0; height: auto; }
    .doom-inputs { flex-shrink: 0; margin-top: 0; padding: 1rem; }
  }
</style>

<script>
  import { initDoomPage } from '@/lib/doom-page'
  import { doomAliasDestination } from '@/lib/doom-aliases'
  const destination = doomAliasDestination(location.pathname, import.meta.env.BASE_URL)
  const root = document.getElementById('doom-simulator')
  if (destination) location.replace(destination + location.search + location.hash)
  else if (root) initDoomPage(root)
</script>
