---
import DocumentViewer from '@/components/document-viewer.astro'
import sharewareLicense from '../../public/doom/licenses/DOOM1-SHAREWARE.txt?raw'
import engineLicense from '../../public/doom/runtime/COPYING.txt?raw'
import correspondingSource from '../../public/doom/runtime/SOURCE.md?raw'
import { sitePath } from '@/lib/site-path'
---

<aside class="border-t border-border/40 pt-5">
  <p class="mb-2 text-xs leading-relaxed text-muted-foreground">DOOM v1.9 shareware · Unofficial port</p>
  <details>
    <summary class="cursor-pointer py-2 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground hover:text-foreground">The boring legal stuff</summary>
    <div class="space-y-3 pt-3 text-xs leading-relaxed text-muted-foreground">
      <DocumentViewer id="doom-documents" documents={[
        { title: 'Shareware license', href: sitePath('/doom/licenses/DOOM1-SHAREWARE.txt'), content: sharewareLicense },
        { title: 'Engine GPLv2', href: sitePath('/doom/runtime/COPYING.txt'), content: engineLicense },
        { title: 'Corresponding source', href: sitePath('/doom/runtime/SOURCE.md'), content: correspondingSource },
      ]} />
      <p>Includes unmodified Doom 1 v1.9 shareware. Commercial Doom data and Freedoom are not included.</p>
      <p>© id Software · Not affiliated with id Software, Bethesda Softworks, or Microsoft.</p>
    </div>
  </details>
</aside>
