---
import { Lightbulb } from 'lucide-react'
import GithubInvertocat from '@/components/github-invertocat.astro'

const tips = [
  {
    before: 'Once the game has started, click the badge screen and type ',
    code: 'IDSPISPOPD',
    after: ' to walk through walls.',
    href: 'https://github.com/id-Software/DOOM/blob/a77dfb96cb91780ca334d0d4cfd86957558007e0/linuxdoom-1.10/st_stuff.c#L426-L431',
    link: 'View the original noclip source',
  },
  {
    before: 'Use the arrow keys to move, Ctrl/J to fire, and Space/K to open doors.',
  },
  {
    before: 'DOOM shareware includes the first episode: Knee-Deep in the Dead.',
  },
  {
    before: "Press the badge's lower right physical button to open the original DOOM source.",
    href: 'https://github.com/id-Software/DOOM',
    link: 'View the DOOM source',
  },
]
---

<aside data-doom-tips class="border-t border-border/40 pt-5" aria-labelledby="doom-tip-title">
  <h2 id="doom-tip-title" class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em]">
    <Lightbulb size={16} className="text-primary" aria-hidden="true" />
    Pro tip
  </h2>
  {tips.map((tip, index) => (
    <div data-doom-tip hidden={index !== 0}>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        {tip.before}{tip.code && <code class="text-foreground">{tip.code}</code>}{tip.after}
      </p>
      {tip.href && (
        <a class="mt-3 inline-flex min-h-10 items-center gap-2.5 font-mono text-xs text-primary hover:underline" href={tip.href}>
          <GithubInvertocat /><span>{tip.link}</span>
        </a>
      )}
    </div>
  ))}
</aside>

<script>
  const tips = [...document.querySelectorAll<HTMLElement>('[data-doom-tip]')]
  let index = 0
  try {
    const previous = Number(sessionStorage.getItem('doom-tip') ?? -1)
    if (Number.isInteger(previous) && previous >= -1 && previous < tips.length) {
      index = (previous + 1) % tips.length
    }
    sessionStorage.setItem('doom-tip', String(index))
  } catch {
    index = Math.floor(Math.random() * tips.length)
  }
  tips.forEach((tip, position) => { tip.hidden = position !== index })
</script>
