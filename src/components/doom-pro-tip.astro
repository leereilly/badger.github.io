---
import { Lightbulb } from 'lucide-react'
import GithubInvertocat from '@/components/github-invertocat.astro'
import { sitePath } from '@/lib/site-path'
---

<aside class="border-t border-border/40 pt-5" aria-labelledby="doom-tip-title">
  <h2 id="doom-tip-title" class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em]">
    <Lightbulb size={16} className="text-primary" aria-hidden="true" />
    Pro tip
  </h2>
  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
    Once the game has started, click the badge screen and type <code class="text-foreground">IDSPISPOPD</code> to walk through walls.
    <picture class="ml-1 inline-block align-middle">
      <source media="(prefers-reduced-motion: reduce)" srcset={sitePath('/images/mona-mindblown.webp')} />
      <img class="inline-block" src={sitePath('/images/mona-mindblown.gif')} alt="Mindblown Mona" width="32" height="32" loading="lazy" decoding="async" />
    </picture>
  </p>
  <a class="mt-3 inline-flex min-h-10 items-center gap-2.5 font-mono text-xs text-primary hover:underline" href="https://github.com/id-Software/DOOM/blob/a77dfb96cb91780ca334d0d4cfd86957558007e0/linuxdoom-1.10/st_stuff.c#L426-L431">
    <GithubInvertocat /><span>View the original noclip source</span>
  </a>
</aside>
