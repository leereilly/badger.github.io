---
import { Lightbulb } from 'lucide-react'
import GithubInvertocat from '@/components/github-invertocat.astro'
import { sitePath } from '@/lib/site-path'
---

<aside data-doom-pro-tip class="border-t border-border/40 pt-5" aria-labelledby="doom-tip-title">
  <h2 id="doom-tip-title" class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.14em]">
    <Lightbulb size={16} className="text-primary" aria-hidden="true" />
    Pro tip
  </h2>
  <p class="doom-touch-tip mt-3 text-sm leading-relaxed text-muted-foreground">
    Open "Play with your GitHub avatar" below the controls to set your avatar, god mode, all weapons and refilling ammo. No keyboard required.
  </p>
  <div class="doom-keyboard-tip">
    <div data-doom-tip-default>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        Once the game has started, click the badge screen and type <code class="text-foreground">IDSPISPOPD</code> to walk through walls.
        <picture class="ml-1 inline-block align-middle">
          <source media="(prefers-reduced-motion: reduce)" srcset={sitePath('/images/mona-mindblown.webp')} />
          <img class="inline-block" src={sitePath('/images/mona-mindblown.gif')} alt="Mindblown Mona" width="32" height="32" loading="lazy" decoding="async" />
        </picture>
      </p>
      <a class="mt-3 inline-flex min-h-10 items-center gap-2.5 font-mono text-xs text-primary hover:underline" href="https://github.com/id-Software/DOOM/blob/a77dfb96cb91780ca334d0d4cfd86957558007e0/linuxdoom-1.10/st_stuff.c#L426-L431">
        <GithubInvertocat /><span>Explore this and other cheat codes in the original source code</span>
      </a>
    </div>
    <p data-doom-tip-discover hidden class="avatar-tip mt-3 text-sm leading-relaxed text-muted-foreground" role="status">
      Once the game has started, click the badge screen, type <code class="text-foreground">@YOUR-GITHUB-USERNAME</code>, then press Enter for your avatar, god mode, all weapons and refilling ammo.
    </p>
    <p data-doom-tip-change hidden class="mt-3 text-sm leading-relaxed text-muted-foreground" role="status">
      During gameplay, type <code class="text-foreground">@YOUR-GITHUB-USERNAME</code> and press Enter to change the avatar.
    </p>
  </div>
</aside>

<style>
  .doom-touch-tip { display: none; }
  @media (max-width: 1023px) {
    .doom-touch-tip { display: block; }
    .doom-keyboard-tip { display: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .avatar-tip[data-attention] { animation: doom-tip-shimmer 1200ms ease-out 1; }
  }
  @keyframes doom-tip-shimmer {
    0%, 100% { opacity: 1; text-shadow: none; }
    40% { opacity: 0.7; text-shadow: 0 0 0.5rem hsl(var(--primary) / 0.25); }
  }
</style>

<script>
  import { initDoomProTip } from '@/lib/doom-pro-tip'
  for (const root of document.querySelectorAll<HTMLElement>('[data-doom-pro-tip]')) initDoomProTip(root)
</script>
