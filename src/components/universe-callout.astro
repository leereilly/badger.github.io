---
import { Play } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
---

<aside aria-label="GitHub Universe 2026" class="mt-6 border-l border-primary/60 pl-4">
  <h2 class="font-mono text-sm uppercase tracking-[0.14em]">GitHub Universe 2026</h2>
  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">Register virtually / watch on demand</p>
  <a
    href="https://githubuniverse.com/?utm_source=GitHub&utm_medium=Site&utm_campaign=virtual_badge_uni_26"
    class={cn(buttonVariants({ variant: 'outline' }), 'mt-3 gap-2.5 text-xs uppercase tracking-[0.12em]')}
  >
    <Play aria-hidden="true" />
    Watch GitHub Universe
  </a>
</aside>
