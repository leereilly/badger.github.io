---
import { Play } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
---

<aside aria-label="GitHub Universe 2026" class="mt-6 border-t border-border/40 pt-5">
  <h2 class="font-mono text-xs uppercase tracking-[0.14em]">GitHub Universe 2026</h2>
  <p class="mt-3 leading-relaxed text-muted-foreground">Hear more about the badge in the keynotes.</p>
  <a
    href="https://githubuniverse.com/?utm_source=GitHub&utm_medium=Site&utm_campaign=virtual_badge_uni_26"
    class={cn(buttonVariants({ variant: 'outline' }), 'mt-3 h-auto min-h-10 w-full gap-2.5 whitespace-normal py-2 text-xs uppercase tracking-[0.12em]')}
  >
    <Play aria-hidden="true" />
    Register virtually / watch on demand
  </a>
</aside>
